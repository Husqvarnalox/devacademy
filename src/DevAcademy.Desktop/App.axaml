        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <!-- IBM Plex (SIL OFL 1.1, Cyrillic included), embedded under Assets/Fonts; system fonts are the fallback chain. -->
      <FontFamily x:Key="UiFont">avares://DevAcademy.Desktop/Assets/Fonts#IBM Plex Sans, Segoe UI, Helvetica Neue, Arial, sans-serif</FontFamily>
      <FontFamily x:Key="MonoFont">avares://DevAcademy.Desktop/Assets/Fonts#IBM Plex Mono, Menlo, Consolas, 'DejaVu Sans Mono', monospace</FontFamily>
      <FontFamily x:Key="ContentControlThemeFontFamily">avares://DevAcademy.Desktop/Assets/Fonts#IBM Plex Sans, Segoe UI, Helvetica Neue, Arial, sans-serif</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0E6A64" RegionColor="#F6F4EF" />
        <ColorPaletteResources x:Key="Dark" Accent="#4DB6AC" RegionColor="#161513" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://DevAcademy.Desktop/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
