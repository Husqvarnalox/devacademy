<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:views="using:DevAcademy.Desktop.Views"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.OnboardingView"
             x:DataType="vm:OnboardingViewModel">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Name="Scroller">
      <StackPanel MaxWidth="720" Margin="24,48,24,32" Spacing="32" HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">
          <TextBlock Text="{loc:T Onboarding_Title}" Classes="display" />
          <TextBlock Text="{loc:T Onboarding_Subtitle}" Classes="secondary" TextWrapping="Wrap" />
        </StackPanel>
        <views:ProfileEditorView DataContext="{Binding Editor}" Tag="numbered" />
        <StackPanel Spacing="12" IsVisible="{Binding HasPaths}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:T Onboarding_Paths}" Classes="h2" />
            <TextBlock Text="{loc:T Onboarding_PathsHint}" Classes="small secondary" TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Paths}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PathChoiceViewModel">
                <Button Classes="tile" Classes.selected="{Binding IsSelected}" Margin="0,0,0,8"
                        Command="{Binding PickCommand}" AutomationProperties.Name="{Binding Title}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Classes="small secondary" TextWrapping="Wrap" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <Grid ColumnDefinitions="*,Auto" MaxWidth="720">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{loc:T Onboarding_PickLanguage}" Classes="small secondary" IsVisible="{Binding !Editor.HasLanguage}" />
          <TextBlock Text="{loc:T Onboarding_Privacy}" Classes="caption muted" />
        </StackPanel>
        <Button Grid.Column="1" Content="{loc:T Onboarding_Start}" Command="{Binding FinishCommand}" Classes="primary large" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
