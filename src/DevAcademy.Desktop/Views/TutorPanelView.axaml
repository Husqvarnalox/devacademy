<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:md="using:DevAcademy.Desktop.Markdown"
             xmlns:tutor="using:DevAcademy.Application.Tutor"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.TutorPanelView"
             x:DataType="vm:TutorPanelViewModel">
  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceBrush}">
    <Expander Name="TutorExpander" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" Padding="12,6" AutomationProperties.Name="{loc:T Tutor_Title}">
      <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{loc:T Tutor_Title}" Classes="h3" VerticalAlignment="Center" />
          <TextBlock Text="{Binding HeaderNote}" Classes="small muted" VerticalAlignment="Center" />
        </StackPanel>
      </Expander.Header>
      <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="0,0,8,0">
          <StackPanel Spacing="6" IsVisible="{Binding IsOffNoticeVisible}">
            <TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap" />
            <Button Content="{loc:T Tutor_OpenSettings}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" />
          </StackPanel>

          <WrapPanel>
            <Button Content="{loc:T Tutor_Explain}" Classes="compact" Command="{Binding AskCommand}" CommandParameter="{x:Static tutor:TutorScenario.Explain}" Margin="0,0,8,6" />
            <Button Content="{loc:T Tutor_Debug}" Classes="compact" Command="{Binding AskCommand}" CommandParameter="{x:Static tutor:TutorScenario.Debug}" Margin="0,0,8,6" />
            <Button Content="{loc:T Tutor_Hint}" Classes="compact" Command="{Binding AskCommand}" CommandParameter="{x:Static tutor:TutorScenario.Hint}" Margin="0,0,8,6" />
            <Button Content="{loc:T Tutor_Review}" Classes="compact" Command="{Binding AskCommand}" CommandParameter="{x:Static tutor:TutorScenario.CodeReview}" Margin="0,0,8,6" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0,0,6">
              <TextBlock Text="{loc:T Tutor_HintLevel}" Classes="small secondary" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding HintLevels}" SelectedItem="{Binding HintLevel}" MinWidth="64" AutomationProperties.Name="{loc:T Tutor_HintLevel}" />
            </StackPanel>
          </WrapPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="{loc:T Tutor_Context}" Classes="overline" />
            <WrapPanel>
              <CheckBox Content="{loc:T Tutor_CtxLesson}" IsChecked="{Binding IncludeLesson}" Margin="0,0,14,0" />
              <CheckBox Content="{loc:T Tutor_CtxCode}" IsChecked="{Binding IncludeCode}" IsEnabled="{Binding CodeAllowed}" Margin="0,0,14,0" />
              <CheckBox Content="{loc:T Tutor_CtxResults}" IsChecked="{Binding IncludeResults}" Margin="0,0,14,0" />
              <CheckBox Content="{loc:T Tutor_CtxPrevious}" IsChecked="{Binding IncludePrevious}" />
            </WrapPanel>
            <TextBlock Text="{Binding CodeBlockedNote}" Classes="caption warn" TextWrapping="Wrap" IsVisible="{Binding HasCodeBlockedNote}" />
          </StackPanel>

          <TextBox Text="{Binding Question}" PlaceholderText="{loc:T Tutor_QuestionHint}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="80"
                   AutomationProperties.Name="{loc:T Tutor_QuestionHint}" />

          <!-- Exact payload preview -->
          <Border Name="PreviewBlock" Classes="panel" Padding="12,10" IsVisible="{Binding IsPreviewVisible}">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:T Tutor_PreviewTitle}" Classes="h3" />
              <TextBlock Text="{Binding PreviewSummary}" Classes="caption" TextWrapping="Wrap" />
              <Expander Header="{loc:T Tutor_PreviewExact}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Border Classes="codeout">
                  <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding PreviewText}" Classes="mono" TextWrapping="Wrap" />
                  </ScrollViewer>
                </Border>
              </Expander>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:T Tutor_Send}" Command="{Binding SendCommand}" Classes="primary" />
                <Button Content="{loc:T Common_Cancel}" Command="{Binding CancelPreviewCommand}" />
              </StackPanel>
              <CheckBox Content="{loc:T Tutor_SkipPreview}" IsChecked="{Binding SkipPreview}" />
            </StackPanel>
          </Border>

          <!-- Answer -->
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsStreaming}">
            <TextBlock Text="{loc:T Tutor_Streaming}" Classes="muted" VerticalAlignment="Center" />
            <Button Content="{loc:T Tutor_StopButton}" Command="{Binding CancelStreamingCommand}" />
          </StackPanel>
          <SelectableTextBlock Text="{Binding ResponseText}" TextWrapping="Wrap" IsVisible="{Binding IsStreaming}" />
          <md:MarkdownViewer Markdown="{Binding ResponseMarkdown}" IsVisible="{Binding HasMarkdown}" />
          <TextBlock Text="{Binding Notice}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding UsageText}" Classes="caption" IsVisible="{Binding UsageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Spacing="6" IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorText}" Classes="warn" TextWrapping="Wrap" />
            <Button Content="{loc:T Tutor_OpenSettings}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" IsVisible="{Binding ShowOpenSettings}" />
          </StackPanel>
          <TextBlock Text="{loc:T Tutor_TextOnly}" Classes="caption muted" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Expander>
  </Border>
</UserControl>
