<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             xmlns:ctl="using:DevAcademy.Desktop.Controls"
             x:Class="DevAcademy.Desktop.Views.ProblemsView"
             x:DataType="vm:ProblemsViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="1200" Margin="32,28,32,48" Spacing="24" HorizontalAlignment="Stretch">
      <StackPanel Spacing="6">
        <TextBlock Text="{loc:T Problems_Title}" Classes="display" />
        <TextBlock Text="{loc:T Practice_Subtitle}" Classes="body secondary" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
      </StackPanel>

      <!-- Wide: tasks | checks; narrow: checks below the tasks (code-behind) -->
      <Grid Name="Columns" ColumnDefinitions="*,340" RowDefinitions="Auto,Auto" ColumnSpacing="32" RowSpacing="32">
        <!-- Tasks -->
        <StackPanel Name="TasksPane" Spacing="12">
          <Border Classes="segmented" IsVisible="{Binding HasAlgorithms}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="segment" Classes.active="{Binding IsAlgorithmsScope}" Content="{loc:T Practice_ScopeAlgorithms}"
                      Command="{Binding SelectScopeCommand}" CommandParameter="{x:Static vm:PracticeScope.Algorithms}" />
              <Button Name="ExercisesScopeButton" Classes="segment" Classes.active="{Binding IsExercisesScope}" Content="{loc:T Practice_ScopeExercises}"
                      Command="{Binding SelectScopeCommand}" CommandParameter="{x:Static vm:PracticeScope.Exercises}" />
            </StackPanel>
          </Border>

          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <TextBox Name="SearchBox" Text="{Binding SearchText}" Width="240" PlaceholderText="{loc:T Practice_Search}"
                     AutomationProperties.Name="{loc:T Practice_Search}">
              <TextBox.InnerLeftContent>
                <ctl:Icon Kind="search" Size="14" Margin="10,0,0,0" Stroke="{DynamicResource TextMutedBrush}" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <ComboBox Name="LanguageFilterBox" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" MinWidth="150"
                      AutomationProperties.Name="{loc:T Practice_Language}" ToolTip.Tip="{loc:T Practice_Language}" />
            <ComboBox Name="DifficultyBox" ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding SelectedDifficulty}" MinWidth="150"
                      AutomationProperties.Name="{loc:T Problems_Difficulty}" ToolTip.Tip="{loc:T Problems_Difficulty}" />
            <ComboBox Name="SolvedBox" ItemsSource="{Binding SolvedOptions}" SelectedItem="{Binding SelectedSolved}" MinWidth="120"
                      AutomationProperties.Name="{loc:T Problems_State}" ToolTip.Tip="{loc:T Problems_State}" />
            <TextBlock Text="{Binding CountText}" Classes="small muted" VerticalAlignment="Center" Margin="4,0,0,0" />
          </WrapPanel>

          <StackPanel Spacing="12" Margin="0,8,0,0" IsVisible="{Binding IsEmpty}">
            <TextBlock Text="{loc:T Problems_Empty}" Classes="secondary" />
            <Button Content="{loc:T Problems_ResetFilters}" Command="{Binding ResetFiltersCommand}" Classes="link" HorizontalAlignment="Left" />
          </StackPanel>

          <StackPanel IsVisible="{Binding !IsEmpty}">
            <Border Classes="tablehead">
              <Grid ColumnDefinitions="*,190,96,92" ColumnSpacing="16">
                <TextBlock Text="{loc:TU Practice_ColTask}" Classes="overline" />
                <TextBlock Grid.Column="1" Text="{loc:TU Practice_ColCourse}" Classes="overline" />
                <TextBlock Grid.Column="2" Text="{loc:TU Problems_Difficulty}" Classes="overline" />
                <TextBlock Grid.Column="3" Text="{loc:TU Problems_State}" Classes="overline" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProblemRowViewModel">
                  <Button Classes="row tablerow" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnDefinitions="*,190,96,92" ColumnSpacing="16">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LanguagesText}" Classes="small muted" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding CourseTitle}" Classes="small secondary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding CourseTitle}" />
                      <TextBlock Grid.Column="2" Text="{Binding DifficultyText}" Classes="small" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ctl:Icon Kind="check" Size="14" Stroke="{DynamicResource SuccessBrush}" IsVisible="{Binding Solved}" />
                        <ctl:Icon Kind="lock" Size="13" Stroke="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsLocked}" ToolTip.Tip="{loc:T Practice_LockedTip}" />
                        <TextBlock Text="{Binding SolvedText}" Classes="small" Classes.success="{Binding Solved}" Classes.muted="{Binding !Solved}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <!-- Knowledge checks + solved per course -->
        <StackPanel Name="SidePane" Grid.Column="1" Spacing="24">
          <Border Classes="panel" Padding="20">
            <StackPanel Spacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:TU Practice_ChecksTitle}" Classes="overline" />
                <TextBlock Text="{loc:T Practice_ChecksText}" Classes="small secondary" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="0" IsVisible="{Binding ShowPlacementList}">
                <TextBlock Text="{loc:T Practice_ChecksEmpty}" Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding !HasPlacements}" />
                <ItemsControl ItemsSource="{Binding Placements}" IsVisible="{Binding HasPlacements}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlacementOfferViewModel">
                      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Title}" Classes="h3" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding CourseTitle}" Classes="small secondary" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Meta}" Classes="small muted" TextWrapping="Wrap" />
                          <Button Content="{loc:T Practice_CheckStart}" Command="{Binding StartCommand}" Classes="primary" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding HasPlacementCheck}">
                <StackPanel Spacing="8" DataContext="{Binding PlacementCheck}" x:DataType="vm:PlacementViewModel">
                  <TextBlock Text="{Binding Title}" Classes="h3" TextWrapping="Wrap" />
                  <ContentControl Content="{Binding Quiz}" />
                  <TextBlock Text="{Binding Outcome}" FontWeight="SemiBold" TextWrapping="Wrap" Classes.success="{Binding Credited}" />
                  <Button Content="{loc:T Placement_Close}" Command="{Binding CloseCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Spacing="10" IsVisible="{Binding HasTopics}">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:TU Practice_TopicsTitle}" Classes="overline" />
              <TextBlock Text="{loc:T Practice_TopicsText}" Classes="small muted" TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Topics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PracticeTopicViewModel">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,10" ColumnSpacing="12" RowSpacing="4">
                    <TextBlock Text="{Binding Title}" Classes="small" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="small muted num" />
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Value="{Binding Fraction}" ShowProgressText="False" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
