<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.ProblemsView"
             x:DataType="vm:ProblemsViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="1040" Margin="32,32" Spacing="16" HorizontalAlignment="Stretch">
      <TextBlock Text="{loc:T Problems_Title}" Classes="display" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="{loc:T Problems_Difficulty}" Classes="label" />
          <ComboBox Name="DifficultyBox" ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding SelectedDifficulty}" MinWidth="176"
                    AutomationProperties.Name="{loc:T Problems_Difficulty}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="{loc:T Problems_State}" Classes="label" />
          <ComboBox Name="SolvedBox" ItemsSource="{Binding SolvedOptions}" SelectedItem="{Binding SelectedSolved}" MinWidth="176"
                    AutomationProperties.Name="{loc:T Problems_State}" />
        </StackPanel>
        <TextBlock Text="{Binding CountText}" Classes="small secondary" VerticalAlignment="Bottom" Margin="0,0,0,8" />
      </StackPanel>
      <Border Classes="panel" Padding="24" IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="12" HorizontalAlignment="Left">
          <TextBlock Text="{loc:T Problems_Empty}" Classes="secondary" />
          <Button Content="{loc:T Problems_ResetFilters}" Command="{Binding ResetFiltersCommand}" Classes="ghost" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border Classes="panel" ClipToBounds="True" IsVisible="{Binding !IsEmpty}">
        <ItemsControl Classes="rows" ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProblemRowViewModel">
              <Border Background="{DynamicResource SurfaceBrush}" Padding="16,12">
                <Grid ColumnDefinitions="24,*,Auto,Auto" ColumnSpacing="16">
                  <TextBlock Text="{Binding Glyph}" FontWeight="Bold" VerticalAlignment="Center"
                             Classes.success="{Binding Solved}" Classes.muted="{Binding !Solved}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CourseTitle}" Classes="small secondary" />
                    <TextBlock Text="{Binding LanguagesText}" Classes="small secondary" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                    <Border Classes="badge" HorizontalAlignment="Right"><TextBlock Classes="caption" Text="{Binding DifficultyText}" /></Border>
                    <TextBlock Text="{Binding SolvedText}" Classes="small secondary" HorizontalAlignment="Right" />
                  </StackPanel>
                  <Button Grid.Column="3" Content="{loc:T Problems_Open}" Command="{Binding OpenCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
