<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:ctl="using:DevAcademy.Desktop.Controls"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.DiagnosticView"
             x:DataType="vm:DiagnosticViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="1040" Margin="32,24,32,48" Spacing="24" HorizontalAlignment="Stretch">
      <StackPanel Spacing="8">
        <Button Content="{loc:T Diagnostic_Back}" Command="{Binding BackCommand}" Classes="link" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Title}" Classes="display" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Intro}" Classes="secondary" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding IntroNote}" Classes="small muted" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding SummaryText}" Classes="mono" Margin="0,8,0,0" IsVisible="{Binding HasRows}" />
      </StackPanel>
      <TextBlock Text="{loc:T Diagnostic_Empty}" Classes="secondary" IsVisible="{Binding !HasRows}" />
      <Border Classes="panel" ClipToBounds="True" IsVisible="{Binding HasRows}">
        <ItemsControl Classes="rows" ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CompetencyRowViewModel">
              <Border Padding="16,14" BorderThickness="2,0,0,0" BorderBrush="Transparent" Classes.next="{Binding IsNext}">
                <Border.Styles>
                  <Style Selector="Border.next"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
                </Border.Styles>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Border Classes="badge" Classes.success="{Binding IsConfirmed}" Classes.warn="{Binding IsNeedsWork}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateText}" />
                      </Border>
                      <Border Classes="badge accent" IsVisible="{Binding IsNext}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NextText}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Classes="small secondary" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                    <TextBlock Text="{Binding EvidenceText}" Classes="small" TextWrapping="Wrap" IsVisible="{Binding HasEvidence}" />
                    <TextBlock Text="{Binding GapText}" Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding HasGapText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="ghost" Content="{Binding StudyGapText}" Command="{Binding StudyGapCommand}" IsVisible="{Binding HasGapLesson}" />
                    <Button Classes="primary" Content="{Binding PrimaryText}" Command="{Binding OpenCheckCommand}" IsVisible="{Binding IsPrimaryAction}" />
                    <Button Classes="link" Content="{Binding PrimaryText}" Command="{Binding OpenCheckCommand}" IsVisible="{Binding IsConfirmed}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
