<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.PythonEnvironmentsView"
             x:DataType="vm:PythonEnvironmentsViewModel">
  <Border Classes="panel" Padding="16">
    <StackPanel Spacing="12">
      <TextBlock Text="{loc:T Py_Title}" Classes="h2" />
      <TextBlock Text="{loc:T Py_Description}" Classes="muted" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{loc:T Py_Interpreters}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Content="{loc:T Runtimes_Refresh}" Command="{Binding DetectInterpretersCommand}" />
        <TextBlock Text="{loc:T Runtimes_Detecting}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsDetecting}" />
      </StackPanel>
      <ItemsControl Name="InterpreterList" ItemsSource="{Binding Interpreters}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InterpreterRow">
            <StackPanel Spacing="1" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding Display}" Classes="h3" />
                <TextBlock Text="{Binding Details}" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Path}" Classes="caption mono" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="hairline" />
      <TextBlock Text="{loc:T Py_Environments}" Classes="h3" />
      <TextBlock Text="{Binding EnvironmentsRoot}" Classes="caption mono" TextWrapping="Wrap" />
      <TextBlock Text="{loc:T Py_NoEnvironments}" Classes="muted" IsVisible="{Binding !HasEnvironments}" />
      <ListBox Name="EnvironmentList" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" Background="Transparent"
               AutomationProperties.Name="{loc:T Py_Environments}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:EnvironmentRow">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding Name}" Classes="h3" />
              <TextBlock Text="{Binding Version}" Classes="caption" VerticalAlignment="Center" />
              <Border Classes="badge"><TextBlock Text="{Binding Tool}" /></Border>
              <Border Classes="badge" IsVisible="{Binding IsActive}"><TextBlock Classes="caption" Text="{loc:T Py_ActiveBadge}" /></Border>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Name="ActiveLine" Text="{Binding ActiveText}" Classes="caption" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="SetActiveButton" Content="{loc:T Py_SetActive}" Command="{Binding SetActiveCommand}" />
        <Button Name="ClearActiveButton" Content="{loc:T Py_ClearActive}" Command="{Binding ClearActiveCommand}" />
        <Button Name="DeleteButton" Content="{loc:T Py_Delete}" Command="{Binding DeleteCommand}" />
      </StackPanel>

      <Border Classes="hairline" />
      <TextBlock Text="{loc:T Py_CreateHeader}" Classes="h3" />
      <Grid ColumnDefinitions="240,160" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="{loc:T Py_Name}" Classes="label" />
          <TextBox Name="NewNameBox" Text="{Binding NewName}" PlaceholderText="{loc:T Py_NameHint}" AutomationProperties.Name="{loc:T Py_Name}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{loc:T Py_Tool}" Classes="label" />
          <ComboBox Name="ToolBox" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" MinWidth="110" AutomationProperties.Name="{loc:T Py_Tool}" />
        </StackPanel>
      </Grid>
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:T Py_Interpreter}" Classes="label" />
        <ComboBox Name="InterpreterBox" ItemsSource="{Binding Interpreters}" SelectedItem="{Binding SelectedInterpreter}"
                  HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Py_Interpreter}" />
      </StackPanel>
      <Button Name="CreateButton" Content="{loc:T Py_Create}" Command="{Binding CreateCommand}" Classes="primary" HorizontalAlignment="Left" />

      <Border Classes="hairline" />
      <TextBlock Text="{loc:T Py_PackagesHeader}" Classes="h3" />
      <TextBlock Text="{Binding PackagesError}" Classes="danger" TextWrapping="Wrap" IsVisible="{Binding PackagesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{loc:T Py_NoPackagesInstalled}" Classes="muted" IsVisible="{Binding !HasPackages}" />
      <ScrollViewer MaxHeight="180">
        <ItemsControl Name="PackageList" ItemsSource="{Binding Packages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PackageRow">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding Name}" Classes="mono" />
                <TextBlock Text="{Binding Version}" Classes="caption mono" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Text="{loc:T Py_InstallHeader}" Classes="h3" />
      <TextBox Name="PackageBox" Text="{Binding PackageText}" AcceptsReturn="True" MinHeight="64" PlaceholderText="{loc:T Py_PackagesHint}"
               FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="{loc:T Py_InstallHeader}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="InstallButton" Content="{loc:T Py_Install}" Command="{Binding InstallPackagesCommand}" Classes="primary" />
        <Button Name="InstallFileButton" Content="{loc:T Py_InstallFile}" Command="{Binding InstallFromFileCommand}" />
        <Button Name="CancelInstallButton" Content="{loc:T Py_CancelInstall}" Command="{Binding CancelInstallCommand}" />
      </StackPanel>
      <Border Classes="codeout" IsVisible="{Binding InstallLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <ScrollViewer MaxHeight="220">
          <SelectableTextBlock Name="InstallLogText" Text="{Binding InstallLog}" Classes="mono" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
      <TextBlock Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Border>
</UserControl>
