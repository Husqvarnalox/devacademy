<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:app="using:DevAcademy.Application.Workspace"
             xmlns:dom="using:DevAcademy.Domain"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">
  <Grid>
    <ScrollViewer IsVisible="{Binding ShowHome}">
      <StackPanel MaxWidth="1040" Margin="32" Spacing="16" HorizontalAlignment="Stretch">
        <TextBlock Text="{loc:T Ws_Title}" Classes="display" />
        <TextBlock Text="{loc:T Ws_Intro}" Classes="muted" TextWrapping="Wrap" />
        <Border Classes="callout warn" Padding="12">
          <TextBlock Text="{loc:T Ws_NoSandbox}" Classes="warn" TextWrapping="Wrap" />
        </Border>
        <TextBlock Text="{Binding Error}" Classes="danger" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:T Ws_OpenFolder}" Command="{Binding OpenFolderCommand}" Classes="primary" />
        </StackPanel>

        <TextBlock Text="{loc:T Ws_Recent}" Classes="h2" />
        <TextBlock Text="{loc:T Ws_RecentEmpty}" Classes="muted" IsVisible="{Binding !HasRecents}" />
        <ItemsControl ItemsSource="{Binding Recents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="app:RecentProject">
              <Border Classes="panel" Padding="16,12" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Path}" Classes="small mono secondary" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{loc:T Ws_Open}" VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Content="{loc:T Ws_Forget}" Classes="ghost" VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).RemoveRecentCommand}" CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{loc:T Ws_Templates}" Classes="h2" />
        <TextBlock Text="{loc:T Ws_TemplatesHint}" Classes="muted" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Templates}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="dom:ProjectTemplate">
              <Border Classes="panel" Padding="16,12" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="small secondary" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{loc:T Ws_CreateFromTemplate}" VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).CreateFromTemplateCommand}" CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <ContentControl Content="{Binding Project}" IsVisible="{Binding HasProject}" />
  </Grid>
</UserControl>
