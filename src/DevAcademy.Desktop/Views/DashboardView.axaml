<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="960" Margin="24,20" Spacing="18" HorizontalAlignment="Stretch">
      <TextBlock Text="{loc:T Dashboard_Title}" Classes="h1" />

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="{loc:T Dashboard_Courses}" Classes="h3" />
          <TextBlock Text="{loc:T Dashboard_NoCourses}" Classes="muted" IsVisible="{Binding !HasCourses}" />
          <ItemsControl ItemsSource="{Binding Courses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CourseRowViewModel">
                <StackPanel Spacing="4" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" />
                  </Grid>
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="6" ShowProgressText="False" />
                  <TextBlock Text="{Binding CreditedText}" Classes="caption" IsVisible="{Binding CreditedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:T Dashboard_Solved}" Classes="h3" />
            <ItemsControl ItemsSource="{Binding Solved}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DifficultyRowViewModel">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Label}" /><TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold" /></Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="panel" Padding="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:T Dashboard_Reviews}" Classes="h3" />
            <TextBlock Text="{Binding DueReviews}" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="{loc:T Dashboard_ReviewsNote}" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="{loc:T Dashboard_Submissions}" Classes="h3" />
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{loc:T Dashboard_Total}" Classes="caption" /><TextBlock Text="{Binding TotalSubmissions}" Classes="caption" /></StackPanel>
          <ItemsControl ItemsSource="{Binding Days}" Height="86">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DayBarViewModel">
                <Border Width="14" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="2" ToolTip.Tip="{Binding Tooltip}"
                        Background="{DynamicResource LineBrush}" Classes.hasvalue="{Binding HasValue}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="{loc:T Dashboard_Recommendations}" Classes="h3" />
          <TextBlock Text="{loc:T Dashboard_NoRecommendations}" Classes="muted" IsVisible="{Binding !HasRecommendations}" />
          <ItemsControl ItemsSource="{Binding Recommendations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecommendationViewModel">
                <Border Background="{DynamicResource SubtleBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="badge"><TextBlock Text="{Binding KindText}" FontSize="12" /></Border>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock Text="{Binding Reason}" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{loc:T Dashboard_Open}" Command="{Binding OpenCommand}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
