<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:md="using:DevAcademy.Desktop.Markdown"
             xmlns:ctl="using:DevAcademy.Desktop.Controls"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.RoadmapView"
             x:DataType="vm:RoadmapViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="1040" Margin="32,24,32,48" Spacing="24" HorizontalAlignment="Stretch">
      <!-- Header -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{loc:T Roadmap_Back}" Command="{Binding BackCommand}" Classes="link" />
          <ctl:Icon Kind="chevron-right" Size="14" Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Title}" Classes="small muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480" />
        </StackPanel>
        <TextBlock Text="{Binding Title}" Classes="display" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Description}" Classes="secondary" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                   MaxLines="{Binding ShownDescriptionLines}" TextTrimming="CharacterEllipsis" />
        <Button Classes="link" Content="{Binding MoreText}" Command="{Binding ToggleDescriptionCommand}" IsVisible="{Binding HasLongDescription}" />
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="0,8,0,0" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="{Binding ProgressText}" FontWeight="Medium" VerticalAlignment="Center" />
          <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Fraction}" ShowProgressText="False" VerticalAlignment="Center" MinWidth="160" />
          <Button Grid.Column="2" Classes="primary large" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsVisible="{Binding HasPrimary}" />
        </Grid>
      </StackPanel>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasFramework}">
        <StackPanel Spacing="6" DataContext="{Binding Framework}" x:DataType="vm:FrameworkInfoViewModel">
          <TextBlock Text="{Binding Title}" Classes="h3" />
          <TextBlock Text="{Binding CurriculumText}" Classes="small muted" />
          <TextBlock Text="{Binding Compatibility}" TextWrapping="Wrap" IsVisible="{Binding HasCompatibility}" />
          <StackPanel Spacing="2" IsVisible="{Binding HasDeprecated}">
            <TextBlock Text="{loc:T Framework_Deprecated}" Classes="h3" />
            <ItemsControl ItemsSource="{Binding Deprecated}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DeprecatedRowViewModel">
                  <TextBlock TextWrapping="Wrap" Classes="warn">
                    <Run Text="{Binding Feature}" Classes="h3" /><Run Text=" — " /><Run Text="{Binding Status}" /><Run Text=": " /><Run Text="{Binding Note}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="2" IsVisible="{Binding HasMigrationNotes}">
            <TextBlock Text="{loc:T Framework_Migration}" Classes="h3" />
            <md:MarkdownViewer Markdown="{Binding MigrationNotes}" />
          </StackPanel>
          <StackPanel Spacing="2" IsVisible="{Binding HasDocs}">
            <TextBlock Text="{loc:T Framework_Docs}" Classes="h3" />
            <ItemsControl ItemsSource="{Binding Docs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Content="{Binding}" Classes="link" HorizontalAlignment="Left"
                          Command="{Binding $parent[UserControl].((vm:RoadmapViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Placements}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PlacementRowViewModel">
            <Border Classes="panel" Padding="16,12" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{loc:T Placement_Skip}" Command="{Binding TakeCommand}" Margin="12,0,0,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="panel" Padding="16" IsVisible="{Binding HasPlacementCheck}">
        <StackPanel Spacing="8" DataContext="{Binding PlacementCheck}" x:DataType="vm:PlacementViewModel">
          <TextBlock Text="{Binding Title}" Classes="h3" TextWrapping="Wrap" />
          <ContentControl Content="{Binding Quiz}" />
          <TextBlock Text="{Binding Outcome}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Button Content="{loc:T Placement_Close}" Command="{Binding CloseCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="12">
        <TextBlock Text="{loc:T Roadmap_Lessons}" Classes="h2" />
        <Border Classes="panel" ClipToBounds="True">
          <ItemsControl Classes="rows" ItemsSource="{Binding Lessons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RoadmapLessonViewModel">
                <Panel>
                  <!-- open: whole row is the button -->
                  <Button Classes="row" Classes.selected="{Binding IsCurrent}" Command="{Binding OpenCommand}" IsVisible="{Binding !IsLocked}" Padding="16,12">
                    <Grid ColumnDefinitions="32,28,*,150">
                      <TextBlock Text="{Binding Number}" Classes="mono muted" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <Panel Grid.Column="1" Width="20" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <ctl:Icon Kind="circle-check" Size="20" Stroke="{DynamicResource SuccessBrush}" IsVisible="{Binding IsCompleted}" />
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsCurrent}" />
                        <Ellipse Width="14" Height="14" Stroke="{DynamicResource LineStrongBrush}" StrokeThickness="1.5" IsVisible="{Binding IsPlain}" />
                      </Panel>
                      <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Goal}" Classes="small secondary" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Meta}" Classes="small muted" />
                        <TextBlock Text="{Binding SourceText}" Classes="small success" IsVisible="{Binding IsCompleted}" />
                      </StackPanel>
                      <TextBlock Grid.Column="3" Text="{Binding OpenText}" FontSize="13" LineHeight="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" Margin="12,0,0,0" FontWeight="Medium" />
                    </Grid>
                  </Button>
                  <!-- locked: quiet, not a button; the way in is a ghost link -->
                  <Border Background="{DynamicResource SurfaceBrush}" Padding="18,12,16,12" IsVisible="{Binding IsLocked}">
                    <Grid ColumnDefinitions="32,28,*,150">
                      <TextBlock Text="{Binding Number}" Classes="mono muted" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <ctl:Icon Grid.Column="1" Kind="lock" Size="16" Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,2,0,0" />
                      <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Meta}" Classes="small muted" />
                        <TextBlock Text="{Binding WhyLocked}" Classes="small muted" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="3" Classes="link" Content="{Binding OpenText}" Command="{Binding OpenCommand}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0" FontSize="13" FontWeight="Medium" />
                    </Grid>
                  </Border>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
