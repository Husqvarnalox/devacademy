<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.NodeEnvironmentView"
             x:DataType="vm:NodeEnvironmentViewModel">
  <Border Classes="panel" Padding="14,12">
    <StackPanel Spacing="10">
      <TextBlock Text="{loc:T Node_Title}" Classes="h3" />
      <TextBlock Text="{loc:T Node_Description}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Name="NodeStatusText" Text="{Binding StatusText}" TextWrapping="Wrap" />
      <TextBlock Name="NodePathText" Text="{Binding PathText}" Classes="caption" TextWrapping="Wrap" />
      <ItemsControl Name="NodePackageList" ItemsSource="{Binding Packages}" IsVisible="{Binding HasPackages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" Classes="caption" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="NodeInstallButton" Content="{loc:T Node_Install}" Command="{Binding InstallCommand}" />
        <Button Name="NodeCancelButton" Content="{loc:T Py_CancelInstall}" Command="{Binding CancelCommand}" />
      </StackPanel>
      <Border Classes="codeout" IsVisible="{Binding InstallLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <ScrollViewer MaxHeight="220">
          <SelectableTextBlock Name="NodeInstallLogText" Text="{Binding InstallLog}" Classes="mono" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
      <TextBlock Name="NodeMessageText" Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Border>
</UserControl>
