<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.GoEnvironmentView"
             x:DataType="vm:GoEnvironmentViewModel">
  <Border Classes="panel" Padding="14,12">
    <StackPanel Spacing="10">
      <TextBlock Text="{loc:T Go_Title}" Classes="h3" />
      <TextBlock Text="{loc:T Go_Description}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Name="GoStatusText" Text="{Binding StatusText}" TextWrapping="Wrap" />
      <TextBlock Name="GoPathText" Text="{Binding PathText}" Classes="caption" TextWrapping="Wrap" />
      <ItemsControl Name="GoSetList" ItemsSource="{Binding Sets}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GoSetViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusText}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{loc:T Sets_Install}" Command="{Binding InstallCommand}" />
                <Button Content="{loc:T Sets_Remove}" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Name="GoCancelButton" Content="{loc:T Py_CancelInstall}" Command="{Binding CancelCommand}" IsVisible="{Binding IsInstalling}" />
      <Border Classes="codeout" IsVisible="{Binding InstallLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <ScrollViewer MaxHeight="220">
          <SelectableTextBlock Name="GoInstallLogText" Text="{Binding InstallLog}" Classes="mono" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
      <TextBlock Name="GoMessageText" Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Border>
</UserControl>
