<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:ctl="using:DevAcademy.Desktop.Controls"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.GradientDescentView"
             x:DataType="vm:GradientDescentViewModel">
  <Border Classes="panel" Padding="16">
    <StackPanel Spacing="16">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12">
        <TextBlock Text="{loc:T Gd_Title}" Classes="h3" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" Name="FunctionBox" ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}" MinWidth="190"
                  AutomationProperties.Name="{loc:T Gd_Function}" />
        <ComboBox Grid.Column="2" Name="OptimizerBox" ItemsSource="{Binding Optimizers}" SelectedItem="{Binding SelectedOptimizer}" MinWidth="130"
                  AutomationProperties.Name="{loc:T Gd_Optimizer}" />
        <TextBlock Grid.Column="3" Text="{Binding PositionText}" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="{Binding FormulaText}" Classes="caption mono" />

      <StackPanel Spacing="8">
        <ctl:GradientPlotControl Name="Plot" Frame="{Binding Frame}" Height="260" AutomationProperties.Name="{loc:T Gd_Plot}" />
        <TextBlock Text="{loc:T Gd_PlotHint}" Classes="caption secondary" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Text="{loc:T Gd_LossChart}" Classes="label" />
        <ctl:LossChartControl Name="LossChart" Frame="{Binding Frame}" Height="128" AutomationProperties.Name="{loc:T Gd_LossChart}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Name="StatusLine" Text="{Binding StatusText}" Classes="body" TextWrapping="Wrap" />
        <TextBlock Text="{Binding DetailText}" Classes="caption mono" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="16" HorizontalAlignment="Left" Width="480">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="BackButton" Content="{loc:T Viz_Back}" Command="{Binding StepBackCommand}" />
          <Button Name="PlayButton" Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" Classes="primary" />
          <Button Name="StepButton" Content="{loc:T Viz_Step}" Command="{Binding StepForwardCommand}" />
          <Button Name="ResetButton" Content="{loc:T Viz_Reset}" Command="{Binding ResetCommand}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:T Viz_Speed}" Classes="label" />
            <TextBlock Grid.Column="1" Text="{Binding Speed, StringFormat='{}{0:0}'}" Classes="caption mono" />
          </Grid>
          <Slider Name="SpeedSlider" Minimum="1" Maximum="60" Value="{Binding Speed}" AutomationProperties.Name="{loc:T Viz_Speed}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:T Gd_LearningRate}" Classes="label" />
            <TextBlock Name="LrText" Grid.Column="1" Text="{Binding LearningRateText}" Classes="caption mono" />
          </Grid>
          <Slider Name="LrSlider" Minimum="-4" Maximum="1" Value="{Binding LogLearningRate}" AutomationProperties.Name="{loc:T Gd_LearningRate}" />
        </StackPanel>
        <TextBlock Text="{Binding HintText}" Classes="caption secondary" TextWrapping="Wrap" />
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:T Gd_Steps}" Classes="label" />
            <TextBlock Grid.Column="1" Text="{Binding StepsText}" Classes="caption mono" />
          </Grid>
          <Slider Name="StepsSlider" Minimum="10" Maximum="1000" Value="{Binding Steps}" AutomationProperties.Name="{loc:T Gd_Steps}" />
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding IsQuadratic}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:T Gd_Conditioning}" Classes="label" />
            <TextBlock Grid.Column="1" Text="{Binding Conditioning, StringFormat='κ = {0:0.#}'}" Classes="caption mono" />
          </Grid>
          <Slider Name="ConditioningSlider" Minimum="1" Maximum="100" Value="{Binding Conditioning}" AutomationProperties.Name="{loc:T Gd_Conditioning}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="{loc:T Gd_Start}" Classes="label" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Name="StartXBox" Text="{Binding StartXText}" Classes="mono" Width="96" PlaceholderText="x" AutomationProperties.Name="x" />
            <TextBox Name="StartYBox" Text="{Binding StartYText}" Classes="mono" Width="96" PlaceholderText="y" IsVisible="{Binding IsTwoDimensional}" AutomationProperties.Name="y" />
            <Button Content="{loc:T Viz_Apply}" Command="{Binding ApplyStartCommand}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Name="ErrorText" Text="{Binding Error}" Classes="danger" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
