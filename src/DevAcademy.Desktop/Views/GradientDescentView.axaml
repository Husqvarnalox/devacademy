<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:ctl="using:DevAcademy.Desktop.Controls"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.GradientDescentView"
             x:DataType="vm:GradientDescentViewModel">
  <Border Classes="panel" Padding="12">
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
        <TextBlock Text="{loc:T Gd_Title}" Classes="h3" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" Name="FunctionBox" ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}" MinWidth="190"
                  AutomationProperties.Name="{loc:T Gd_Function}" />
        <ComboBox Grid.Column="2" Name="OptimizerBox" ItemsSource="{Binding Optimizers}" SelectedItem="{Binding SelectedOptimizer}" MinWidth="130"
                  AutomationProperties.Name="{loc:T Gd_Optimizer}" />
        <TextBlock Grid.Column="3" Text="{Binding PositionText}" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="{Binding FormulaText}" Classes="caption" FontFamily="{StaticResource MonoFont}" />

      <ctl:GradientPlotControl Name="Plot" Frame="{Binding Frame}" Height="260" AutomationProperties.Name="{loc:T Gd_Plot}" />
      <TextBlock Text="{loc:T Gd_PlotHint}" Classes="caption" TextWrapping="Wrap" />
      <TextBlock Text="{loc:T Gd_LossChart}" Classes="caption" />
      <ctl:LossChartControl Name="LossChart" Frame="{Binding Frame}" Height="120" AutomationProperties.Name="{loc:T Gd_LossChart}" />

      <TextBlock Name="StatusLine" Text="{Binding StatusText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding DetailText}" Classes="caption" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Name="BackButton" Content="{loc:T Viz_Back}" Command="{Binding StepBackCommand}" />
        <Button Name="PlayButton" Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" Classes="primary" />
        <Button Name="StepButton" Content="{loc:T Viz_Step}" Command="{Binding StepForwardCommand}" />
        <Button Name="ResetButton" Content="{loc:T Viz_Reset}" Command="{Binding ResetCommand}" />
        <TextBlock Text="{loc:T Viz_Speed}" Classes="caption" VerticalAlignment="Center" Margin="12,0,0,0" />
        <Slider Name="SpeedSlider" Minimum="1" Maximum="60" Value="{Binding Speed}" Width="140" VerticalAlignment="Center"
                AutomationProperties.Name="{loc:T Viz_Speed}" />
      </StackPanel>

      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Text="{loc:T Gd_LearningRate}" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Name="LrSlider" Minimum="-4" Maximum="1" Value="{Binding LogLearningRate}" AutomationProperties.Name="{loc:T Gd_LearningRate}" />
        <TextBlock Grid.Column="2" Name="LrText" Text="{Binding LearningRateText}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" MinWidth="110" />
      </Grid>
      <TextBlock Text="{Binding HintText}" Classes="caption" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Text="{loc:T Gd_Steps}" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Name="StepsSlider" Minimum="10" Maximum="1000" Value="{Binding Steps}" AutomationProperties.Name="{loc:T Gd_Steps}" />
        <TextBlock Grid.Column="2" Text="{Binding StepsText}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" MinWidth="110" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding IsQuadratic}">
        <TextBlock Text="{loc:T Gd_Conditioning}" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Name="ConditioningSlider" Minimum="1" Maximum="100" Value="{Binding Conditioning}" AutomationProperties.Name="{loc:T Gd_Conditioning}" />
        <TextBlock Grid.Column="2" Text="{Binding Conditioning, StringFormat='κ = {0:0.#}'}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" MinWidth="110" />
      </Grid>

      <Grid ColumnDefinitions="Auto,100,Auto,100,Auto" ColumnSpacing="8">
        <TextBlock Text="{loc:T Gd_Start}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Name="StartXBox" Text="{Binding StartXText}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="x" />
        <TextBlock Grid.Column="2" Text="y" VerticalAlignment="Center" IsVisible="{Binding IsTwoDimensional}" />
        <TextBox Grid.Column="3" Name="StartYBox" Text="{Binding StartYText}" FontFamily="{StaticResource MonoFont}" IsVisible="{Binding IsTwoDimensional}" AutomationProperties.Name="y" />
        <Button Grid.Column="4" Content="{loc:T Viz_Apply}" Command="{Binding ApplyStartCommand}" />
      </Grid>
      <TextBlock Name="ErrorText" Text="{Binding Error}" Classes="danger" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    </StackPanel>
  </Border>
</UserControl>
