<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:lsp="using:DevAcademy.Desktop.ViewModels.Lsp"
             xmlns:ctl="using:DevAcademy.Desktop.Controls"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             xmlns:views="using:DevAcademy.Desktop.Views"
             x:Class="DevAcademy.Desktop.Views.SessionView"
             x:DataType="vm:ExerciseSessionViewModel">
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:ConsoleResultViewModel">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
          <ctl:Icon Kind="circle-check" Stroke="{DynamicResource SuccessBrush}" IsVisible="{Binding IsSuccess}" VerticalAlignment="Center" />
          <ctl:Icon Kind="circle-x" Stroke="{DynamicResource DangerBrush}" IsVisible="{Binding !IsSuccess}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Classes.success="{Binding IsSuccess}" Classes.danger="{Binding !IsSuccess}" />
          <TextBlock Text="{Binding DurationText}" Classes="small muted mono" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ExitCodeText}" Classes="small muted mono" VerticalAlignment="Center" />
          <Border Classes="badge" Classes.warn="{Binding IsWeakIsolation}" ToolTip.Tip="{Binding IsolationBadge}"><TextBlock Text="{Binding IsolationBadge}" TextWrapping="Wrap" /></Border>
        </WrapPanel>
        <TextBlock Text="{Binding Message}" Classes="warn" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
        <StackPanel Spacing="4" IsVisible="{Binding HasCompileOutput}">
          <TextBlock Text="{loc:T Out_Compile}" Classes="overline" />
          <Border Classes="codeout"><SelectableTextBlock Text="{Binding CompileOutput}" Classes="mono" TextWrapping="Wrap" /></Border>
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding HasStdout}">
          <TextBlock Text="{loc:TU Out_Stdout}" Classes="overline" />
          <Border Classes="codeout"><SelectableTextBlock Text="{Binding Stdout}" Classes="mono" TextWrapping="Wrap" /></Border>
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding HasStderr}">
          <TextBlock Text="{loc:TU Out_Stderr}" Classes="overline" />
          <Border Classes="codeout"><SelectableTextBlock Text="{Binding Stderr}" Classes="mono danger" TextWrapping="Wrap" /></Border>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:DataType="vm:TestReportViewModel">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
          <ctl:Icon Kind="circle-check" Stroke="{DynamicResource SuccessBrush}" IsVisible="{Binding IsPassed}" VerticalAlignment="Center" />
          <ctl:Icon Kind="circle-x" Stroke="{DynamicResource DangerBrush}" IsVisible="{Binding !IsPassed}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" Classes.success="{Binding IsPassed}" Classes.danger="{Binding !IsPassed}" />
          <TextBlock Text="{Binding DurationText}" Classes="small muted mono" VerticalAlignment="Center" />
          <Border Classes="badge" Classes.warn="{Binding IsWeakIsolation}" ToolTip.Tip="{Binding IsolationBadge}"><TextBlock Text="{Binding IsolationBadge}" TextWrapping="Wrap" /></Border>
        </WrapPanel>
        <Border Classes="codeout" IsVisible="{Binding HasMessage}"><SelectableTextBlock Text="{Binding Message}" Classes="mono" TextWrapping="Wrap" /></Border>
        <StackPanel IsVisible="{Binding Cases.Count}">
          <Border Classes="hairline" />
          <ItemsControl ItemsSource="{Binding Cases}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TestCaseViewModel">
                <Border Classes="tablerow" Classes.failed="{Binding !Passed}" Padding="8,8">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <ctl:Icon Kind="check" Size="14" Stroke="{DynamicResource SuccessBrush}" IsVisible="{Binding Passed}" VerticalAlignment="Center" />
                      <ctl:Icon Kind="x" Size="14" Stroke="{DynamicResource DangerBrush}" IsVisible="{Binding !Passed}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding DurationText}" Classes="small muted mono" VerticalAlignment="Center" IsVisible="{Binding HasDuration}" />
                    </Grid>
                    <TextBlock Text="{Binding Message}" Classes="small" Classes.danger="{Binding !Passed}" Classes.secondary="{Binding Passed}" TextWrapping="Wrap" Margin="24,0,0,0" IsVisible="{Binding HasMessage}" />
                    <Expander Header="{loc:T Out_ShowDiff}" Margin="20,0,0,0" IsVisible="{Binding HasDetail}">
                      <Border Classes="codeout">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Stdin, StringFormat='stdin: {0}'}" Classes="mono muted" IsVisible="{Binding Stdin, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Expected, StringFormat='expected: {0}'}" Classes="mono success" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Actual, StringFormat='actual: {0}'}" Classes="mono danger" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="{loc:T Tests_DurationNote}" Classes="caption" FontWeight="Regular" TextWrapping="Wrap" IsVisible="{Binding HasCaseDurations}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding Debug.StartOrContinueCommand}" />
    <KeyBinding Gesture="Shift+F5" Command="{Binding Debug.StopCommand}" />
    <KeyBinding Gesture="F10" Command="{Binding Debug.StepOverCommand}" />
    <KeyBinding Gesture="F11" Command="{Binding Debug.StepIntoCommand}" />
    <KeyBinding Gesture="Shift+F11" Command="{Binding Debug.StepOutCommand}" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
    <!-- Toolbar: file name left; Debug, Check and Run (primary) right and never wrap; hint / reset / save live in the overflow menu. -->
    <Border Grid.Row="0" Classes="bar" MinHeight="44" Padding="12,0,8,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ClipToBounds="True">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SelectedFile.Path}" Classes="mono" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Name="DebugButton" Command="{Binding Debug.StartOrContinueCommand}" IsVisible="{Binding CanRun}" Classes="quiet compact"
                IsEnabled="{Binding Debug.IsAvailable}" AutomationProperties.Name="{loc:T Dbg_Button}">
          <ToolTip.Tip>
            <StackPanel Spacing="2" MaxWidth="280">
              <TextBlock Text="{loc:T Dbg_Tip}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Debug.AdapterText}" TextWrapping="Wrap" IsVisible="{Binding Debug.AdapterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel Orientation="Horizontal" Spacing="6"><ctl:Icon Kind="bug" Size="14" /><TextBlock Text="{loc:T Dbg_Button}" /></StackPanel>
        </Button>
        <Button Grid.Column="2" Name="SubmitButton" Content="{loc:T Editor_Submit}" Command="{Binding SubmitCommand}" IsVisible="{Binding CanSubmit}" Classes="compact"
                ToolTip.Tip="{loc:T Editor_SubmitTip}" />
        <Button Grid.Column="3" Name="RunButton" Command="{Binding RunCommand}" IsVisible="{Binding CanRun}" Classes="primary compact"
                ToolTip.Tip="{loc:T Editor_RunTip}">
          <StackPanel Orientation="Horizontal" Spacing="6"><ctl:Icon Kind="play" Size="14" /><TextBlock Text="{loc:T Editor_Run}" /></StackPanel>
        </Button>
        <Button Name="MoreButton" Grid.Column="4" Classes="quiet compact icon" ToolTip.Tip="{loc:T Editor_More}" AutomationProperties.Name="{loc:T Editor_More}">
          <ctl:Icon Kind="ellipsis" Size="18" StrokeWidth="3" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{Binding HintButtonText}" Command="{Binding RevealHintCommand}" IsVisible="{Binding HasHints}"
                        ToolTip.Tip="{loc:T Editor_HintTip}">
                <MenuItem.Icon><ctl:Icon Kind="lightbulb" Size="14" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:T Editor_Reset}" Command="{Binding ResetCommand}" IsVisible="{Binding CanSubmit}" ToolTip.Tip="{loc:T Editor_ResetTip}">
                <MenuItem.Icon><ctl:Icon Kind="rotate-ccw" Size="14" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:T Editor_Save}" Command="{Binding SaveDraftCommand}" IsVisible="{Binding CanSubmit}" ToolTip.Tip="{loc:T Editor_SaveTip}">
                <MenuItem.Icon><ctl:Icon Kind="save" Size="14" /></MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- Info strip: language (switchable for multi-language exercises), missing runtime, shortcuts; then environment notices -->
    <StackPanel Grid.Row="1">
    <Border Classes="bar" Padding="12,0" MinHeight="32">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding LanguageName}" Classes="small secondary" VerticalAlignment="Center" IsVisible="{Binding !IsMultiLanguage}" />
          <TextBlock Text="{loc:T Lang_Label}" Classes="small muted" VerticalAlignment="Center" IsVisible="{Binding IsMultiLanguage}" />
          <ComboBox Name="LanguageBox" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" MinWidth="140" MinHeight="26" FontSize="13"
                    IsVisible="{Binding IsMultiLanguage}" AutomationProperties.Name="{loc:T Lang_Label}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding RuntimeHint}" Classes="small warn" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,6"
                   IsVisible="{Binding IsRuntimeMissing}" />
        <TextBlock Grid.Column="2" Text="{x:Static vm:ExerciseSessionViewModel.ShortcutsText}" Classes="caption" FontWeight="Regular" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Name="EnvironmentBar" Classes="bar" Padding="12,6" IsVisible="{Binding HasEnvironmentNotice}">
      <StackPanel Spacing="6">
        <TextBlock Name="EnvironmentNoticeText" Text="{Binding EnvironmentText}" Classes="small warn" TextWrapping="Wrap"
                   IsVisible="{Binding EnvironmentText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasInstallSet}">
          <Button Name="InstallSetButton" Content="{Binding InstallSetText}" Command="{Binding InstallSetCommand}" Classes="primary compact" />
          <Button Name="CancelSetInstallButton" Content="{loc:T Py_CancelInstall}" Command="{Binding CancelSetInstallCommand}" IsVisible="{Binding IsInstallingSet}" Classes="compact" />
        </StackPanel>
        <Border Classes="codeout" IsVisible="{Binding InstallLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <ScrollViewer MaxHeight="140">
            <SelectableTextBlock Name="InstallSetLogText" Text="{Binding InstallLog}" Classes="mono" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </StackPanel>
    </Border>
    </StackPanel>

    <!-- File tabs -->
    <Border Grid.Row="2" Classes="bar" IsVisible="{Binding HasMultipleFiles}">
      <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:EditorFileViewModel"><TextBlock Text="{Binding Path}" Classes="mono" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Editor + status bar -->
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}">
      <Grid RowDefinitions="*,Auto">
        <ctl:CodeEditorControl Name="CodeEditor" LspTarget="{Binding SelectedFile.Lsp}" DebugTarget="{Binding SelectedFile.Debug}" Text="{Binding SelectedFile.Content, Mode=TwoWay}" FileName="{Binding SelectedFile.Path}"
                               AutomationProperties.Name="{loc:T Editor_Name}" />
        <Border Grid.Row="1" Classes="statusbar">
          <Grid ColumnDefinitions="Auto,*">
            <Button Name="LspStatusButton" Classes="link statuslink" IsVisible="{Binding HasLsp}" HorizontalAlignment="Left"
                    Command="{Binding LspHelpCommand}" ToolTip.Tip="{Binding LspStatus.Tooltip}">
              <TextBlock Text="{Binding LspStatus.Text}" Classes="small" Classes.warn="{Binding LspStatus.NeedsHelp}" Classes.danger="{Binding LspStatus.IsError}" />
            </Button>
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Classes="small muted" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <GridSplitter Grid.Row="4" Classes="hairline rows" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

    <!-- Output -->
    <!-- Tab order must match ExerciseSessionViewModel.ConsoleTab..DebugTab. -->
    <TabControl Grid.Row="5" Height="260" SelectedIndex="{Binding OutputTab}" Padding="0">
      <TabItem Header="{loc:T Out_Console}" IsVisible="{Binding CanRun}">
        <ScrollViewer>
          <StackPanel Margin="12,10" Spacing="10">
            <StackPanel Spacing="6">
              <ToggleButton Name="StdinToggle" Classes="disclosure" IsChecked="{Binding Stdin, Mode=OneTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            AutomationProperties.Name="{loc:T Out_Stdin}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ctl:Icon Name="StdinChevron" Kind="chevron-right" Size="12" />
                  <TextBlock Text="{loc:T Out_Stdin}" Classes="small" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Spacing="4" IsVisible="{Binding #StdinToggle.IsChecked}">
                <TextBox Text="{Binding Stdin}" AcceptsReturn="True" Height="52" FontFamily="{StaticResource MonoFont}" FontSize="13"
                         AutomationProperties.Name="{loc:T Out_Stdin}" />
                <TextBlock Text="{loc:T Out_StdinHint}" Classes="small muted" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="{loc:T Out_NoRun}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding ConsoleResult, Converter={x:Static ObjectConverters.IsNull}}" />
            <ContentControl Content="{Binding ConsoleResult}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding TestsHeader}" IsVisible="{Binding CanSubmit}">
        <ScrollViewer>
          <StackPanel Margin="12,10" Spacing="8">
            <TextBlock Text="{loc:T Out_NoSubmit}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding Report, Converter={x:Static ObjectConverters.IsNull}}" />
            <ContentControl Content="{Binding Report}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding HintsHeader}" IsVisible="{Binding HasHints}">
        <ScrollViewer>
          <StackPanel Margin="12,10" Spacing="8">
            <TextBlock Text="{loc:T Hints_None}" Classes="secondary" IsVisible="{Binding !RevealedCount}" />
            <ItemsControl ItemsSource="{Binding Hints}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HintItemViewModel">
                  <StackPanel Spacing="2" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Header}" Classes="overline" />
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{loc:T Solution_Button}" Command="{Binding ShowSolutionCommand}" IsVisible="{Binding HasSolution}" HorizontalAlignment="Left" Classes="compact" />
            <ItemsControl ItemsSource="{Binding SolutionFiles}" IsVisible="{Binding IsSolutionVisible}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EditorFileViewModel">
                  <StackPanel Spacing="2" Margin="0,4,0,8">
                    <TextBlock Text="{Binding Path}" Classes="small muted mono" />
                    <Border Classes="codeout"><SelectableTextBlock Text="{Binding Content}" Classes="mono" /></Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding ProblemsHeader}" IsVisible="{Binding HasLsp}">
        <ScrollViewer>
          <StackPanel Margin="12,10" Spacing="2">
            <TextBlock Text="{loc:T Out_NoProblems}" Classes="secondary" IsVisible="{Binding !Problems.Count}" />
            <ItemsControl ItemsSource="{Binding Problems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="lsp:ProblemItemViewModel">
                  <Button Classes="quiet compact" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Command="{Binding $parent[UserControl].((vm:ExerciseSessionViewModel)DataContext).OpenProblemCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Glyph}" Classes.danger="{Binding IsError}" Classes.warn="{Binding IsWarning}" />
                      <TextBlock Text="{Binding Location}" Classes="mono muted" />
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:T Dbg_Tab}" IsVisible="{Binding CanRun}">
        <views:DebugPanelView DataContext="{Binding Debug}" IsHorizontal="True" />
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
