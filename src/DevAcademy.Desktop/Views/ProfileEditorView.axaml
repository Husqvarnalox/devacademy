<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.ProfileEditorView"
             x:DataType="vm:ProfileEditorViewModel">
  <!-- Tag="numbered" prefixes the section titles with 1/2/3/4 (onboarding); Settings leaves it unset. -->
  <StackPanel Spacing="32">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="1." Classes="h2 muted" IsVisible="{Binding $parent[UserControl].Tag, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{loc:T Onboarding_Language}" Classes="h2" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Languages}" Margin="0,0,-12,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TrackChoiceViewModel">
            <Button Classes="tile" Classes.selected="{Binding IsSelected}" Margin="0,0,12,12"
                    IsEnabled="{Binding IsAvailable}"
                    Command="{Binding PickCommand}"
                    AutomationProperties.Name="{Binding Title}">
              <Grid RowDefinitions="Auto,Auto" MinHeight="64">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" Classes="badge" IsVisible="{Binding !IsAvailable}" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Catalog_Soon}" Classes="caption" />
                  </Border>
                </Grid>
                <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="{Binding Description}" Classes="small secondary"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="2." Classes="h2 muted" IsVisible="{Binding $parent[UserControl].Tag, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{loc:T Onboarding_Goal}" Classes="h2" />
      </StackPanel>
      <ListBox Classes="choices" ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}" IsVisible="{Binding $parent[UserControl].Tag, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceBase"><StackPanel Spacing="2">
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Description}" Classes="small secondary" TextWrapping="Wrap" />
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ListBox Classes="segmented" ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}" IsVisible="{Binding $parent[UserControl].Tag, Converter={x:Static ObjectConverters.IsNull}}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceBase"><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="3." Classes="h2 muted" IsVisible="{Binding $parent[UserControl].Tag, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{loc:T Onboarding_Level}" Classes="h2" />
      </StackPanel>
      <ListBox Classes="choices" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" IsVisible="{Binding $parent[UserControl].Tag, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceBase"><StackPanel Spacing="2">
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Description}" Classes="small secondary" TextWrapping="Wrap" />
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ListBox Classes="segmented" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" IsVisible="{Binding $parent[UserControl].Tag, Converter={x:Static ObjectConverters.IsNull}}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceBase"><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{loc:T Prior_Note}" Classes="small muted" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="4." Classes="h2 muted" IsVisible="{Binding $parent[UserControl].Tag, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{loc:T Onboarding_Depth}" Classes="h2" />
      </StackPanel>
      <ListBox Classes="choices" ItemsSource="{Binding Depths}" SelectedItem="{Binding SelectedDepth}" IsVisible="{Binding $parent[UserControl].Tag, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceBase"><StackPanel Spacing="2">
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Description}" Classes="small secondary" TextWrapping="Wrap" />
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ListBox Classes="segmented" ItemsSource="{Binding Depths}" SelectedItem="{Binding SelectedDepth}" IsVisible="{Binding $parent[UserControl].Tag, Converter={x:Static ObjectConverters.IsNull}}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceBase"><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </StackPanel>
</UserControl>
