<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.NuGetEnvironmentView"
             x:DataType="vm:NuGetEnvironmentViewModel">
  <Border Classes="panel" Padding="16">
    <StackPanel Spacing="12">
      <TextBlock Text="{loc:T NuGet_Title}" Classes="h2" />
      <TextBlock Text="{loc:T NuGet_Description}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Name="NuGetStatusText" Text="{Binding StatusText}" TextWrapping="Wrap" />
      <TextBlock Name="NuGetPathText" Text="{Binding PathText}" Classes="caption" TextWrapping="Wrap" />
      <ItemsControl Name="NuGetSetList" ItemsSource="{Binding Sets}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NuGetSetViewModel">
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" Padding="0,12,0,0"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusText}" Classes="caption" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UnavailableText}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !IsAvailable}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{loc:T Sets_Install}" Command="{Binding InstallCommand}" IsVisible="{Binding IsAvailable}" />
                <Button Content="{loc:T Sets_Remove}" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" />
              </StackPanel>
            </Grid></Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Name="NuGetCancelButton" Content="{loc:T Py_CancelInstall}" Command="{Binding CancelCommand}" IsVisible="{Binding IsInstalling}" />
      <Border Classes="codeout" IsVisible="{Binding InstallLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <ScrollViewer MaxHeight="220">
          <SelectableTextBlock Name="NuGetInstallLogText" Text="{Binding InstallLog}" Classes="mono" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
      <TextBlock Name="NuGetMessageText" Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Border>
</UserControl>
