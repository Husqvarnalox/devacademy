<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:ctl="using:DevAcademy.Desktop.Controls"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.PathView"
             x:DataType="vm:PathViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="1040" Margin="32,24,32,48" Spacing="24" HorizontalAlignment="Stretch">
      <Button Content="{loc:T Roadmap_Back}" Command="{Binding BackCommand}" Classes="link" HorizontalAlignment="Left" />
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Title}" Classes="display" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Description}" Classes="secondary" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding GoalText}" Classes="small muted" />
        <TextBlock Text="{Binding ProgressText}" Classes="mono" Margin="0,8,0,0" />
        <TextBlock Text="{Binding CreditedText}" Classes="small success" IsVisible="{Binding HasCredited}" />
        <TextBlock Text="{Binding KnownText}" Classes="small success" IsVisible="{Binding HasKnown}" />
        <Button Classes="ghost" Content="{Binding FollowText}" Command="{Binding ToggleFollowCommand}" HorizontalAlignment="Left" />
      </StackPanel>

      <Border Classes="panel" Padding="16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3" IsVisible="{Binding HasNextStep}">
            <TextBlock Text="{loc:T Path_NextStep}" Classes="overline" />
            <TextBlock Text="{Binding NextStepTitle}" Classes="h2" TextWrapping="Wrap" />
            <TextBlock Text="{Binding NextStepReason}" Classes="secondary" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Text="{loc:T Path_Finished}" Classes="success" IsVisible="{Binding IsFinished}" />
          <Button Grid.Column="1" Content="{loc:T Path_OpenNext}" Command="{Binding OpenNextCommand}" Classes="primary large"
                  IsVisible="{Binding HasNextStep}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <StackPanel Spacing="8" IsVisible="{Binding HasAlternatives}">
        <TextBlock Text="{loc:T Path_Alternatives}" Classes="h2" />
        <ItemsControl ItemsSource="{Binding Alternatives}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AlternativeGroupViewModel">
              <Border Classes="panel" Padding="16" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Hint}" Classes="small muted" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AlternativeChoiceViewModel">
                        <Button Margin="0,0,8,6" Classes.primary="{Binding IsSelected}" Content="{Binding Title}"
                                Command="{Binding $parent[ItemsControl].((vm:AlternativeGroupViewModel)DataContext).ChooseCommand}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding HasGraph}">
        <TextBlock Text="{loc:T Path_Graph}" Classes="h2" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ctl:CourseGraphControl Model="{Binding Graph}" NodeCommand="{Binding OpenCourseFromGraphCommand}" HorizontalAlignment="Left" />
        </ScrollViewer>
      </StackPanel>

      <Border Classes="panel" Padding="16" IsVisible="{Binding HasPlacementCheck}">
        <StackPanel Spacing="8" DataContext="{Binding PlacementCheck}" x:DataType="vm:PlacementViewModel">
          <TextBlock Text="{Binding Title}" Classes="h3" TextWrapping="Wrap" />
          <ContentControl Content="{Binding Quiz}" />
          <TextBlock Text="{Binding Outcome}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Button Content="{loc:T Placement_Close}" Command="{Binding CloseCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Stages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PathStageViewModel">
            <StackPanel Spacing="6" Margin="0,0,0,10">
              <TextBlock Text="{Binding Title}" Classes="overline" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Courses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PathCourseViewModel">
                    <Border Classes="panel" Padding="16" Margin="0,0,0,8" Opacity="1">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}" Classes="h3" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProgressText}" Classes="small muted" />
                            <TextBlock Text="{Binding CreditedText}" Classes="small success" IsVisible="{Binding HasCredited}" />
                            <TextBlock Text="{loc:T Path_NotChosen}" Classes="small warn" IsVisible="{Binding IsNotChosen}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="ghost" Content="{loc:T Catalog_OpenCourse}" Command="{Binding OpenCourseCommand}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPlacement}">
                          <TextBlock Text="{Binding PlacementText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Content="{loc:T Placement_Skip}" Command="{Binding TakePlacementCommand}" Margin="12,0,0,0" />
                        </Grid>
                        <Expander Header="{loc:T Path_Lessons}" HorizontalAlignment="Stretch">
                          <ItemsControl ItemsSource="{Binding Lessons}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:PathLessonViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                  <StackPanel Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                      <Border Classes="badge"><TextBlock Text="{Binding StateText}" /></Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding KnownText}" Classes="small success" IsVisible="{Binding HasKnownText}" />
                                    <TextBlock Text="{Binding SharedText}" Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding HasSharedText}" />
                                  </StackPanel>
                                  <Button Grid.Column="1" Classes="ghost compact" Content="{loc:T Path_OpenLesson}" Command="{Binding OpenCommand}" Margin="12,0,0,0" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Expander>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="6" IsVisible="{Binding HasOtherPaths}">
        <TextBlock Text="{loc:T Path_OtherPaths}" Classes="h2" />
        <ItemsControl ItemsSource="{Binding OtherPaths}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OtherPathViewModel">
              <Button Content="{Binding Title}" Command="{Binding OpenCommand}" Margin="0,0,0,6" HorizontalAlignment="Left" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
