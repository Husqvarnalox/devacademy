<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevAcademy.Desktop.ViewModels"
             xmlns:loc="using:DevAcademy.Desktop.Localization"
             x:Class="DevAcademy.Desktop.Views.MlAccelerationView"
             x:DataType="vm:MlAccelerationViewModel">
  <Border Classes="panel" Padding="16">
    <StackPanel Spacing="12">
      <TextBlock Text="{loc:T Ml_Title}" Classes="h2" />
      <TextBlock Text="{loc:T Ml_Description}" Classes="muted" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="{loc:T Runtimes_Refresh}" Command="{Binding DetectCommand}" />
        <TextBlock Text="{loc:T Runtimes_Detecting}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsDetecting}" />
      </StackPanel>
      <TextBlock Name="SystemLine" Text="{Binding SystemText}" Classes="caption" TextWrapping="Wrap" />
      <ItemsControl Name="HardwareList" ItemsSource="{Binding Hardware}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CapabilityRow">
            <StackPanel Spacing="1" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding Title}" Classes="h3" />
                <Border Classes="badge"><TextBlock Text="{Binding Status}" /></Border>
              </StackPanel>
              <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="hairline" />
      <TextBlock Text="{loc:T Ml_ProbeHeader}" Classes="h3" />
      <TextBlock Text="{loc:T Ml_ProbeNote}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{loc:T Py_NoEnvironments}" Classes="muted" IsVisible="{Binding !HasEnvironments}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox Name="EnvBox" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" MinWidth="200" AutomationProperties.Name="{loc:T Ml_Environment}" />
        <Button Name="ProbeButton" Content="{loc:T Ml_Probe}" Command="{Binding ProbeCommand}" />
      </StackPanel>
      <TextBlock Name="ProbeLine" Text="{Binding ProbeMessage}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding ProbeMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ItemsControl Name="FrameworkList" ItemsSource="{Binding Frameworks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CapabilityRow">
            <StackPanel Spacing="1" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding Title}" Classes="h3" />
                <Border Classes="badge"><TextBlock Text="{Binding Status}" /></Border>
              </StackPanel>
              <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
